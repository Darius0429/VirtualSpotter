         return 1 - abs(rot_left / rot_axle - 1)
     return 0
+
+def session_best_laptime(data_list: list, column: int, laptime: int = 99999):
+    """Find session best lap time from data list"""
+    for data in data_list:
+        if 0 < data[column] < laptime:
+            laptime = data[column]
+    return laptime
